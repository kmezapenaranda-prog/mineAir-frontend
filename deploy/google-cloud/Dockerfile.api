FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MINEAIR_DB_PATH=/data/estado_servicio.db
RUN pip install --no-cache-dir fastapi==0.115.12 uvicorn==0.34.2 jsonschema==4.23.0
COPY src ./src
COPY telemetria.schema.json variables_operativas.schema.json prediccion.schema.json ./
COPY models ./models
RUN useradd --uid 10001 --create-home mineair && mkdir /data && chown mineair:mineair /data
USER mineair
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "src.servicio.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
